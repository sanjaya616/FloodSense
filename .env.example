# GEMINI_API_KEY: Required for server-side Gemini multimodal image verification.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client SDK Configuration (Required only when running in Live Firebase Cloud Mode)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin SDK Service Account JSON (Required on server for ID token verification and trusted public_reports sync)
FIREBASE_SERVICE_ACCOUNT_JSON=""
