# GEMINI_API_KEY: Required for server-side Gemini multimodal image verification.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client SDK Configuration (Required only when running in Live Firebase Cloud Mode)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server Operation Mode: DEMO (local demonstration evaluation) or LIVE (fail-closed Firebase Admin authentication)
FLOODSENSE_MODE="DEMO"

# Firebase Admin SDK Service Account JSON (Required on server for Admin Firestore sync and officer CLI/bootstrap)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional Firestore named database ID (defaults to firestoreDatabaseId from firebase-applet-config.json)
FIREBASE_DATABASE_ID=""

# Optional one-time secret (>=16 chars) to allow bootstrapping the VERY FIRST Emergency Officer when /officers is empty
OFFICER_BOOTSTRAP_SECRET=""
