rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default-deny all undefined paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOfficer() {
      return isSignedIn() && (
        request.auth.token.role == 'officer' ||
        request.auth.token.officer == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isValidFileName(fileName) {
      return fileName.size() > 0 && fileName.size() <= 160 && fileName.matches('^[a-zA-Z0-9._\\-]+$');
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // Private report photographs: readable ONLY by the report owner or authorized officers
    // Upload path matches users' authenticated UID under reports/{userId}/{fileName}
    match /reports/{userId}/{fileName} {
      allow read: if isOwner(userId) || isOfficer();

      allow create: if isOwner(userId)
        && isValidFileName(fileName)
        && isValidImage()
        && request.resource.size > 32;

      allow delete: if isOwner(userId) || isOfficer();

      allow update: if false;
    }

    // Optional officer-curated sanitized public thumbnails
    match /public_reports/{reportId}/{fileName} {
      allow read: if true;
      allow create: if isOfficer() && isValidFileName(fileName) && isValidImage();
      allow delete: if isOfficer();
      allow update: if false;
    }
  }
}
