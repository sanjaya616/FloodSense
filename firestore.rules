rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Officers are validated strictly via custom token claims or trusted server document
    function isOfficer() {
      return isSignedIn() && (
        request.auth.token.role == 'officer' ||
        request.auth.token.officer == true ||
        exists(/databases/$(database)/documents/officers/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Coordinate validation helper
    function isValidCoordinates(lat, lng) {
      return lat is number && lat >= -90.0 && lat <= 90.0
        && lng is number && lng >= -180.0 && lng <= 180.0;
    }

    // Validate FloodReport payload structure
    function isValidReport(data) {
      return data.keys().hasAll(['id', 'location', 'area', 'lat', 'lng', 'waterLevel', 'roadAccessibility', 'floodType', 'riskLevel', 'incidentStatus', 'reporterId'])
        && data.id is string && data.id.size() <= 64
        && data.location is string && data.location.size() <= 200
        && data.area is string && data.area.size() <= 80
        && isValidCoordinates(data.lat, data.lng)
        && data.waterLevel in ['Low', 'Moderate', 'High', 'Severe']
        && data.roadAccessibility in ['Open', 'Partially Blocked', 'Completely Blocked']
        && data.floodType in ['Street Waterlogging', 'Flash Flood', 'Canal Overflow', 'Drainage Blockage']
        && data.riskLevel in ['HIGH', 'MEDIUM', 'LOW']
        && data.incidentStatus in ['Submitted', 'Under Review', 'More Info Requested', 'Verified', 'Alert Issued', 'Resolved', 'Rejected']
        && data.reporterId is string && data.reporterId.size() <= 128;
    }

    // Users collection: Private user accounts
    // Users CANNOT assign themselves roles or modify role attributes
    match /users/{userId} {
      allow get: if isOwner(userId) || isOfficer();
      allow list: if isOfficer();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == userId
        // New registrations may ONLY create a citizen profile (never officer/admin)
        && (!('role' in incoming()) || incoming().role == 'citizen')
        && (!('isOfficer' in incoming()) || incoming().isOfficer == false);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == userId
        // Enforce role immutability from client: users cannot self-assign role or officer privileges
        && (!('role' in incoming()) || incoming().role == existing().role)
        && (!('isOfficer' in incoming()) || incoming().isOfficer == existing().isOfficer);
      allow delete: if isOwner(userId) || isOfficer();
    }

    // Trusted Officers Registry (Managed strictly by Firebase Admin SDK server-side)
    match /officers/{officerId} {
      allow read: if isOfficer();
      allow write: if false; // Only server-side Firebase Admin SDK can grant officer privileges
    }

    // Reports collection: Full incident reports with reporter PII
    // PII Protection: Only the creator of the report or an authorized officer can read full reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isOfficer());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isOfficer());
      
      // Citizen report submission: Must be authenticated and reporterId must match request.auth.uid
      allow create: if isSignedIn()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().reporterId == request.auth.uid
        && incoming().incidentStatus == 'Submitted'
        && incoming().verificationStatus == 'UNDER REVIEW';

      // Updates:
      // 1. Citizen updating description/image while Submitted or More Info Requested (cannot alter AI, verification, risk, officer notes)
      // 2. Authorized officer updating official verification and incident status
      allow update: if isValidId(reportId) && isValidReport(incoming()) && (
        (isOwner(existing().reporterId)
          && existing().incidentStatus in ['Submitted', 'More Info Requested']
          && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'additionalObservations', 'imageUrl'])) ||
        (isOfficer()
          && incoming().diff(existing()).affectedKeys().hasOnly(['incidentStatus', 'verificationStatus', 'officerNotes', 'statusHistory', 'verificationTimestamp', 'verifiedBy', 'riskLevel', 'aiConfidence', 'aiClassification', 'aiStatus', 'aiVerificationDetails']))
      );

      // Deletion: Only owner (if not verified yet) or officer
      allow delete: if (isOwner(existing().reporterId) && existing().incidentStatus == 'Submitted') || isOfficer();
    }

    // Public sanitized incident reports (Used for public GIS maps - ZERO PII: No phone numbers, no emails)
    match /public_reports/{reportId} {
      allow read: if true; // Public access for citizen flood awareness
      allow create, update: if isSignedIn() && isValidId(reportId)
        && (!('reporterPhone' in incoming()))
        && (!('reporterEmail' in incoming()));
      allow delete: if isOfficer();
    }

    // Notifications collection: Scoped per citizen recipient or officers
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isOfficer());
      allow create: if isSignedIn() && (isOfficer() || incoming().recipientUid == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isOfficer())
        && incoming().diff(existing()).affectedKeys().hasOnly(['unread']);
      allow delete: if isOfficer();
    }

    // Status History collection: Audit trail entries linked to reports
    match /status_history/{historyId} {
      allow get, list: if isSignedIn() && (resource.data.citizenUid == request.auth.uid || isOfficer());
      allow create: if isSignedIn() && (
        (incoming().citizenUid == request.auth.uid && incoming().status == 'Submitted') ||
        isOfficer()
      );
      allow update, delete: if false; // Immutable audit history
    }

    // System Settings collection: Clustering & risk thresholds (Read public/signed-in, write officer-only)
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isOfficer();
    }

    // Hotspots collection: Public read for early warning; updates restricted to authorized officers / backend
    match /hotspots/{hotspotId} {
      allow read: if true;
      allow create, update, delete: if isOfficer();
    }

    // Blockchain Event Registry: Public read for auditability; append-only by authorized officers
    match /blockchain_records/{recordId} {
      allow read: if true;
      allow create: if isOfficer()
        && isValidId(recordId)
        && incoming().txHash is string;
      allow update, delete: if false; // Truly immutable audit records
    }
  }
}
